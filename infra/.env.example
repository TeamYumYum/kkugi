# docker compose가 치환하는 변수. `cp infra/.env.example infra/.env` 후 값을 채운다. infra/.env는 커밋하지 않는다.
# Secret은 개인 값만 넣고 공유 채널·문서·AI 프롬프트에 붙여 넣지 않는다(docs/secret-environment-variables.md).

# --- MySQL / Spring 데이터소스 (필수) ---
# 필수 Secret. MySQL root 비밀번호.
MYSQL_ROOT_PASSWORD=
# 필수. 업무 DB 스키마 이름.
DB_NAME=
# 필수. Spring이 쓰는 DB 계정.
DB_USERNAME=
# 필수 Secret.
DB_PASSWORD=

# --- Redis (필수) ---
# 필수 Secret.
REDIS_PASSWORD=

# --- ai/ 추론 서버 (선택) ---
# 비우거나 true면 Claude mock. 실제 호출은 false + 아래 두 값.
CLAUDE_MOCK=
# CLAUDE_MOCK=false일 때 필수 Secret.
GMS_API_KEY=
# CLAUDE_MOCK=false일 때 필수.
GMS_BASE_URL=
# 선택. 비우면 ai 기본값.
CLAUDE_MODEL=
VISION_MODEL_NAME=
VISION_MODEL_STAGE=

# --- 호스트 포트 (선택, 비우면 기본값) ---
# nginx 80, MySQL 3306, Redis 6379, MLflow 5000. nginx 외에는 127.0.0.1에만 열린다.
NGINX_HOST_PORT=
MYSQL_HOST_PORT=
REDIS_HOST_PORT=
MLFLOW_HOST_PORT=

# --- 모니터링 (docker-compose.monitoring-agent.yml·monitoring-server.yml을 겹칠 때만) ---
# 필수 Secret(모니터링 서버 쪽). Grafana 관리자 계정. 익명 접근과 가입은 꺼져 있다.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# 선택(backend 쪽). metric·로그·trace의 env·version 값. 비우면 local·dev.
APP_ENV=
APP_VERSION=
# 필수(backend 쪽). Alloy가 보낼 모니터링 서버 주소. 아래 값은 경우 1(같은 호스트, compose 내부 주소)이다.
# 경우 2(별도 모니터링 서버)에서는 세 개를 모두 모니터링 서버 주소로 바꾼다. 하나라도 비면 compose가 멈춘다.
# 경우 2 예: http://10.0.1.20:3100/loki/api/v1/push, 10.0.1.20:4317, http://10.0.1.20:9090/api/v1/write
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
TEMPO_OTLP_ENDPOINT=tempo:4317
PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write
# 선택(모니터링 서버 쪽). Loki·Tempo OTLP·Prometheus 수신 포트를 열 주소. 비우면 127.0.0.1.
# 경우 2에서는 모니터링 서버의 사설 IP를 넣고, 보안 그룹으로 backend 호스트에서 오는 연결만 허용한다.
MONITORING_BIND_ADDR=
# 선택. 모니터링 호스트 포트. 비우면 Grafana 3000, Prometheus 9090, Loki 3100, Tempo 조회 3200, Tempo OTLP 4317, Alloy 12345.
# Grafana·Tempo 조회·Alloy는 항상 127.0.0.1에만 열린다.
GRAFANA_HOST_PORT=
PROMETHEUS_HOST_PORT=
LOKI_HOST_PORT=
TEMPO_HOST_PORT=
TEMPO_OTLP_HOST_PORT=
ALLOY_HOST_PORT=
