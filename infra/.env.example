# docker compose가 치환하는 변수. `cp infra/.env.example infra/.env` 후 값을 채운다. infra/.env는 커밋하지 않는다.
# Secret은 개인 값만 넣고 공유 채널·문서·AI 프롬프트에 붙여 넣지 않는다(docs/secret-environment-variables.md).

# --- MySQL / Spring 데이터소스 (필수) ---
# 필수 Secret. MySQL root 비밀번호.
MYSQL_ROOT_PASSWORD=
# 필수. 업무 DB 스키마 이름.
DB_NAME=
# 필수. Spring이 쓰는 DB 계정.
DB_USERNAME=
# 필수 Secret.
DB_PASSWORD=

# --- Redis (필수) ---
# 필수 Secret.
REDIS_PASSWORD=

# --- ai/ 추론 서버 (선택) ---
# 비우거나 true면 Claude mock. 실제 호출은 false + 아래 두 값.
CLAUDE_MOCK=
# CLAUDE_MOCK=false일 때 필수 Secret.
GMS_API_KEY=
# CLAUDE_MOCK=false일 때 필수.
GMS_BASE_URL=
# 선택. 비우면 ai 기본값.
CLAUDE_MODEL=
VISION_MODEL_NAME=
VISION_MODEL_STAGE=

# --- 호스트 포트 (선택, 비우면 기본값) ---
# nginx 80, MySQL 3306, Redis 6379, MLflow 5000. nginx 외에는 127.0.0.1에만 열린다.
NGINX_HOST_PORT=
MYSQL_HOST_PORT=
REDIS_HOST_PORT=
MLFLOW_HOST_PORT=

# --- 관측 overlay (docker-compose.observability.yml을 겹칠 때만) ---
# 필수 Secret. Grafana 관리자 계정. 익명 접근과 가입은 꺼져 있다.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# 선택. 지표·로그·추적의 env·version 값. 비우면 local·dev.
APP_ENV=
APP_VERSION=
# 선택. 관측 호스트 포트(모두 127.0.0.1). 비우면 Grafana 3000, Prometheus 9090, Loki 3100, Tempo 3200, Alloy 12345.
GRAFANA_HOST_PORT=
PROMETHEUS_HOST_PORT=
LOKI_HOST_PORT=
TEMPO_HOST_PORT=
ALLOY_HOST_PORT=
