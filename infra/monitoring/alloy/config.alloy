// Alloy 설정(backend 쪽). backend가 있는 호스트에서 돌며 세 경로를 모두 모니터링 서버로 보낸다(push).
// 보낼 주소는 환경 변수로 받는다. 기본값은 compose가 경우 1의 내부 주소로 채운다(docker-compose.monitoring-agent.yml).
// 1) metric: backend 관리 포트 /actuator/prometheus를 15초마다 읽어 Prometheus로 remote write한다.
//    WAL에 쌓아 두므로 모니터링 서버가 잠시 멈춰도 복구 후 이어서 보낸다.
// 2) 로그: Docker 로그(backend 컨테이너) → JSON 파싱 → Loki. 라벨은 service·env·version·level만 쓰고
//    trace_id·span_id는 structured metadata로 보낸다(카디널리티 제한).
// 3) trace: backend OTel Java Agent(OTLP HTTP) → actuator span 버림 → url.query 제거·url.full의 쿼리 제거 → Tempo.
//    쿼리 문자열 값이 backend 호스트 밖으로 나가지 않게 한다.
//    metric 수집 요청(관리 포트 /actuator/*)은 15초마다 trace를 만들어 검색을 가리므로 저장하지 않는다.

// ---------- metric ----------
prometheus.scrape "backend" {
  // job·instance label을 Prometheus가 직접 수집하던 때와 같게 둔다(job="backend", instance="backend:8081")
  job_name        = "backend"
  targets         = [{"__address__" = "backend:8081"}]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}

// ---------- 로그 ----------
discovery.docker "backend" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    // 프로젝트 값은 infra/docker-compose.yml의 compose 프로젝트 이름(name: nyamnyam)과 같아야 한다
    values = ["com.docker.compose.project=nyamnyam", "com.docker.compose.service=backend"]
  }
}

loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.backend.targets
  // JSON이 아닌 줄(JVM·agent 기동 메시지)도 service 라벨로 찾을 수 있게 한다
  labels     = { service = "kkugi-backend" }
  forward_to = [loki.process.backend.receiver]
}

loki.process "backend" {
  stage.json {
    expressions = {
      level    = "level",
      service  = "service",
      env      = "env",
      version  = "version",
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }

  stage.labels {
    values = { level = "", service = "", env = "", version = "" }
  }

  stage.structured_metadata {
    values = { trace_id = "", span_id = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
}

// ---------- 추적 ----------
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.filter.drop_actuator.input]
  }
}

otelcol.processor.filter "drop_actuator" {
  error_mode = "ignore"

  traces {
    span = [
      `IsMatch(attributes["url.path"], "^/actuator(/|$)")`,
    ]
  }

  output {
    traces = [otelcol.processor.transform.redact.input]
  }
}

otelcol.processor.transform "redact" {
  error_mode = "ignore"

  trace_statements {
    context    = "span"
    statements = [
      `delete_key(attributes, "url.query")`,
      `replace_pattern(attributes["url.full"], "\\?.*$", "")`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = sys.env("TEMPO_OTLP_ENDPOINT")
    tls {
      insecure = true
    }
  }
}
