# ai/ 추론 서버가 읽는 변수. 로컬 단독 실행 때 셸에 export한다(앱은 .env 파일을 직접 읽지 않는다).
# docker compose로 띄울 때는 infra/.env에 같은 이름으로 넣는다(infra/.env.example).

# 선택. 비우거나 true(기본)면 Claude를 호출하지 않고 고정 문구를 돌려준다. 실제 호출은 false.
CLAUDE_MOCK=
# CLAUDE_MOCK=false일 때 필수 Secret. 개인 값은 .env에만 둔다.
GMS_API_KEY=
# CLAUDE_MOCK=false일 때 필수. SSAFY GMS의 Anthropic 호환 엔드포인트 기본 URL.
GMS_BASE_URL=
# 선택. 비우면 claude-haiku-4-5-20251001
CLAUDE_MODEL=

# 선택. 비우면 레지스트리를 건너뛰고 로컬 캐시만 본다.
MLFLOW_TRACKING_URI=
# 선택. 기본 nyamnyam-vision / Production / model-cache
VISION_MODEL_NAME=
VISION_MODEL_STAGE=
MODEL_CACHE_DIR=
